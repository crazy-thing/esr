{
  "schemaVersion": 1,
  "id": "esr",
  "version": "${version}",
  "name": "Enchanting System ReImagined",
  "description": "Loot de-enchanting, a global single-max-level enchantment cap, chiseled-bookshelf-driven guaranteed enchanting, and equal loot-chest spawn chances for all enchantments including modded ones.",
  "authors": [
    "Joshua Powell",
    "Taylor Roof"
  ],
  "contact": {
    "homepage": "https://github.com/crazy-thing/esr/issues"
  },
  "license": "MIT",
  "icon": "assets/esr/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.crazything.esr.EnchantingSystemReImagined"
    ],
    "modmenu": [
      "net.crazything.esr.config.EnchantingSystemReImaginedModMenu"
    ]
  },
  "mixins": [
    "esr.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "fabric-api": "*",
    "minecraft": "~1.20.1",
    "java": ">=17"
  }
}